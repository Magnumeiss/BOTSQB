#!/usr/bin/env python3
"""
War Thunder server-relay WRPL REAL player/vehicle extractor.

What it does:
- validates/decompresses the WRPL zlib packet stream;
- extracts player slot records (name, player ID, team, entity refs);
- correlates directly evidenced vehicle names from kill/critical/severe-damage MPI packets;
- NEVER treats "dummy_plane" or unrelated mission/NPC vehicle strings as player vehicles.

IMPORTANT: pass ALL server replay parts from the same match. Part 0 often contains only pre-spawn placeholders. Example:
    py wt_relay_players_vehicles.py "C:\\ReplayParts" -o players_vehicles.json

Optional for Zstd-compressed slot packets:
    py -m pip install zstandard
The script also falls back to a system `zstd` executable when available.
"""
from __future__ import annotations

